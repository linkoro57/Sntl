-- L'UI d'origine est dans la charge obfusquee : les textes sont donc
-- renommes au moment de la creation des composants WindUI.
local function sentinelText(value)
    if type(value) ~= "string" then return value end
    -- Remplacer la marque EN ENTIER d'abord : "H4xScripts" ne doit surtout
    -- pas devenir "Sentinel StudioScripts".
    value = value:gsub("[Hh]4[Xx]%s*[Ss][Cc][Rr][Ii][Pp][Tt][Ss]", "Sentinel Studio")
    value = value:gsub("[Hh]4[Xx]", "Sentinel Studio")
    -- Texte du badge de version vert et autres versions affichees par l'UI.
    -- Cette substitution concerne les textes WindUI, pas le backend chiffre.
    value = value:gsub("3%.2%.1", "Beta")
    return value
end

