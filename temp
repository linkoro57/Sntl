local function replaceDisplayValues(config, depth)
    if type(config) ~= "table" or depth > 5 then return config end
    local result = cloneTable(config)
    for key, value in pairs(result) do
        if type(value) == "string" then
            if UI.TextMap[value] ~= nil then value = UI.TextMap[value] end
            if UI.ImageMap[value] ~= nil then value = UI.ImageMap[value] end
            result[key] = sentinelText(value)
        elseif type(value) == "table" and (
            key == "Thumbnail" or key == "OpenButton" or key == "User"
            or key == "Buttons" or key == "Image" or key == "Icon"
            or key == "Tags" or key == "Tag" or key == "Badge"
            or key == "Badges" or key == "Footer" or key == "Topbar"
            or key == "Header" or key == "Status"
            or type(key) == "number"  -- items of Tags/Badges/Buttons arrays
        ) then
            result[key] = replaceDisplayValues(value, depth + 1)
        end
    end
    return result
end

local function mergeDisplayConfig(config, patch)
    local result = cloneTable(config)
    if type(result) ~= "table" then return config end
    if type(patch) == "table" then
        for key, value in pairs(patch) do
            if value ~= nil and key ~= "Callback" then
                result[key] = value
            end
        end
    end
    return replaceDisplayValues(result, 0)
end

local uiMethods = {
    "Tab", "CreateTab", "Section", "Group", "Button", "Toggle",
    "Dropdown", "Slider", "Input", "Paragraph", "Text", "Label",
    "Image", "Code", "Keybind", "Colorpicker", "ColorPicker",
    "Checkbox", "Divider", "ButtonGroup", "Header", "Space",
    "Tag", "Badge", "Info",
}
local patchContainer
patchContainer = function(container)
    if type(container) ~= "table" or uiPatched[container] then
        return container
    end
    uiPatched[container] = true
    counters[container] = {}
    -- Les setters modifient parfois des titres APRES la construction de l'UI.
    -- Les renommer egalement, sans toucher aux callbacks.
    for _, setterName in ipairs({
        "SetTitle", "SetDesc", "SetDescription", "SetText", "SetContent", "SetName",
    }) do
        local nativeSetter = container[setterName]
        if type(nativeSetter) == "function" then
            pcall(function()
                container[setterName] = function(self, value, ...)
                    return nativeSetter(self, sentinelText(value), ...)
                end
            end)
        end
    end
    if type(container.Paragraph) == "function" then
        nativeParagraphs[container] = container.Paragraph
    end

    for _, methodName in ipairs(uiMethods) do
        local original = container[methodName]
        if type(original) == "function" then
            -- Certaines versions de WindUI exposent des tables figees.
            pcall(function()
                container[methodName] = function(self, options, ...)
                    local config = type(options) == "string" and sentinelText(options) or options
                    if type(options) == "table" then
                        local override
                        local title = options.Title
                        if methodName == "Tab" or methodName == "CreateTab" then
                            local c = counters[container]
                            c.Tabs = (c.Tabs or 0) + 1
                            override = UI.TabsByTitle[title] or UI.TabsByIndex[c.Tabs]
                        elseif methodName == "Section" then
                            override = UI.SectionsByTitle[title]
                        else
                            override = UI.ElementsByTitle[title]
                        end
                        config = mergeDisplayConfig(options, override)
                    end
                    local isTab = methodName == "Tab" or methodName == "CreateTab"
                    local isSection = methodName == "Section" or methodName == "Group"
                    local withinHome = homeContainers[container] == true
                    local withinChangelog = changelogContainers[container] == true
                    local tabName = containerTabNames[container]
                    if isTab then
                        local proposed = type(config) == "table" and
                            (config.Title or config.Name) or nil
                        withinHome = isHomeTitle(proposed)
                        withinChangelog = isChangelogTitle(proposed)
                        tabName = proposed
                    elseif isSection and type(config) == "table"
                        and isChangelogTitle(config.Title or config.Name) then
                        withinChangelog = true
                    end
                    if withinChangelog and not isTab and not isSection then
                        -- Le changelog obfusque d'origine ne doit rien ajouter :
                        -- seules les vraies features collectees apparaissent.
                        return fakeElement()
                    end
                    if not withinHome and not withinChangelog and not isTab
                        and featureMethods[methodName] and type(config) == "table" then
                        addFeature(tabName, config.Title or config.Name)
                    end
                    if withinHome and not isTab then
                        -- Un composant Rank uniquement visuel n'est pas cree.
                        if UI.Home.RemoveRank
                            and (methodName == "Paragraph" or methodName == "Label"
                                 or methodName == "Text" or methodName == "Header")
                            and type(config) == "table"
                            and isRankStat(config.Title or config.Name or config.Text) then
                            return setmetatable({}, {
                                __index = function() return function() end end
                            })
                        end
                        -- Une image creee comme composant independant est masquee.
                        if UI.Home.HideImages and methodName == "Image" then
                            return setmetatable({}, {
                                __index = function() return function() end end
                            })
                        end
                        config = patchHomeConfig(config, false, 0)
                    end
                    local discordTemplates
                    if withinHome and not isTab then
                        config, discordTemplates = prepareDiscordStatConfig(config)
                    end
                    -- Appel aux fonctions WindUI d'origine pour le reste de l'UI.
                    local results = table.pack(original(self, config, ...))
                    if discordTemplates and type(results[1]) == "table" then
                        trackedDiscordStats[#trackedDiscordStats + 1] = {
                            element = results[1], templates = discordTemplates,
                        }
                    end
                    if type(results[1]) == "table" then
                        if withinHome then homeContainers[results[1]] = true end
                        if withinChangelog then
                            changelogContainers[results[1]] = true
                        end
                        if type(tabName) == "string" then
                            containerTabNames[results[1]] = tabName
                        end
                        patchContainer(results[1])
                        if withinChangelog and not changelogContainer and
                            type(nativeParagraphs[results[1]]) == "function" then
                            changelogContainer = results[1]
                            updateFeatureChangelog()
                        end
                    end
                    return table.unpack(results, 1, results.n)
                end
            end)
        end
    end
    return container
end

-- Les icones des notifications WindUI sont facultatives : ne pas les
-- transmettre a la bibliotheque, sans modifier le texte ni les boutons.
local function notificationWithoutIcon(options)
    local config = replaceDisplayValues(options, 0)
    if type(config) == "table" then
        config.Icon = nil
        config.IconThemed = nil
    end
    return config
end

local function patchWindUI(candidate)
    if type(candidate) ~= "table" or type(candidate.CreateWindow) ~= "function" then
        return candidate
    end
    if uiPatched[candidate] then return candidate end
    uiPatched[candidate] = true
    currentWindUI = candidate
    for _, method in ipairs({"Notify", "Notification", "Popup", "Dialog"}) do
        local original = candidate[method]
        if type(original) == "function" then
            local isStartupModal = (method == "Dialog" or method == "Popup")
            local isNotification = (method == "Notify" or method == "Notification")
            pcall(function()
                candidate[method] = function(self, options, ...)
                    if isStartupModal and suppressLobbyStartupPopup() then
                        return fakeElement()
                    end
                    local config = isNotification and notificationWithoutIcon(options)
                        or replaceDisplayValues(options, 0)
                    return original(self, config, ...)
                end
            end)
        end
    end
    local nativeCreateWindow = candidate.CreateWindow
    pcall(function()
        candidate.CreateWindow = function(self, options, ...)
            local config = mergeDisplayConfig(options, UI.Window)
            if type(config) == "table" then
                config.Title = "Sentinel Studio"
                config.Author = "Made by linkoro57"
                config.Icon = ""       -- Retirer l'icone du coin superieur gauche
                config.IconSize = 0
                config.Logo = nil
                -- Le petit bouton flottant visible quand la fenetre est reduite
                -- n'utilise pas toujours Window.Title : il a son propre Title.
                -- Conserver ses options (couleurs, taille, comportement), mais
                -- imposer le nom Sentinel Studio a la minimisation.
                local openButton = type(config.OpenButton) == "table"
                    and cloneTable(config.OpenButton) or {}
                openButton.Title = "Sentinel Studio"
                config.OpenButton = openButton
                -- Si la version/etiquette verte est passee dans CreateWindow.
                for _, key in ipairs({"Version", "Badge", "Tag", "Status"}) do
                    if type(config[key]) == "string" then
                        config[key] = sentinelText(config[key])
                    end
                end
                -- Le systeme de cles integre a WindUI est desactive.
                config.KeySystem = nil
            end
            local results = table.pack(nativeCreateWindow(self, config, ...))
            if type(results[1]) == "table" then
                patchContainer(results[1])
                local window = results[1]
                -- WindUI peut egalement changer le titre du bouton de
                -- minimisation APRES CreateWindow avec EditOpenButton.
                -- Forcer le titre sans modifier les autres reglages.
                local nativeEditOpenButton = window.EditOpenButton
                if type(nativeEditOpenButton) == "function" then
                    pcall(function()
                        window.EditOpenButton = function(selfWindow, optionsButton, ...)
                            local patched = type(optionsButton) == "table"
                                and cloneTable(optionsButton) or {}
                            patched.Title = "Sentinel Studio"
                            return nativeEditOpenButton(selfWindow, patched, ...)
                        end
                    end)
                    -- Appliquer aussi au bouton deja construit.
                    pcall(nativeEditOpenButton, window, { Title = "Sentinel Studio" })
                end
                -- Selon les versions de WindUI, Notify peut aussi appartenir
                -- a l'objet Window plutot qu'a la bibliotheque globale.
                for _, name in ipairs({"Notify", "Notification"}) do
                    local nativeNotify = window[name]
                    if type(nativeNotify) == "function" then
                        pcall(function()
                            window[name] = function(selfWindow, notification, ...)
                                return nativeNotify(selfWindow,
                                    notificationWithoutIcon(notification), ...)
                            end
                        end)
                    end
                end
                local dialog = window.Dialog
                if type(dialog) == "function" then
                    pcall(function()
                        window.Dialog = function(selfWindow, optionsDialog, ...)
                            if suppressLobbyStartupPopup() then
                                return fakeElement()
                            end
                            return dialog(selfWindow,
                                replaceDisplayValues(optionsDialog, 0), ...)
                        end
                    end)
                end
            end
            return table.unpack(results, 1, results.n)
        end
    end)
    return candidate
end

local function seemsWindUISource(source)
    return type(source) == "string" and #source > 100
       and (source:find("CreateWindow", 1, true) ~= nil)
       and (source:find("WindUI", 1, true) ~= nil)
end

local function wrapCompiler(nativeCompiler)
    return function(source, ...)
        local compiled, err = nativeCompiler(source, ...)
        if type(compiled) ~= "function" or not seemsWindUISource(source) then
            return compiled, err
        end
        return function(...)
            local results = table.pack(compiled(...))
            for n = 1, results.n do
                results[n] = patchWindUI(results[n])
            end
            return table.unpack(results, 1, results.n)
        end
    end
end

if type(originalLoadstring) == "function" then
    loadstring = wrapCompiler(originalLoadstring)
end
if type(originalLoad) == "function" then
    load = wrapCompiler(originalLoad)
end
if type(originalRequire) == "function" then
    require = function(...)
        local result = originalRequire(...)
        return patchWindUI(result)
    end
end

