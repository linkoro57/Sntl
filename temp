local function ensureExecutorFolders()
    if type(makefolder) ~= "function" then return end
    local root = UI.Branding.WorkspaceRoot
    local gameFolder = root .. "/" .. UI.Branding.WorkspaceGame
    -- Un dossier deja existant peut faire echouer makefolder : c'est normal.
    local function ensureFolder(path)
        if type(isfolder) == "function" then
            local ok, exists = pcall(isfolder, path)
            if ok and exists then return end
        end
        pcall(makefolder, path)
    end
    ensureFolder(root)
    ensureFolder(gameFolder)
end
