            pcall(function() environment.load = load end)
        end
        if type(originalRequire) == "function" then
            pcall(function() environment.require = require end)
        end
        if type(originalSetclipboard) == "function" then
            pcall(function() environment.setclipboard = setclipboard end)
        end
        if type(originalToclipboard) == "function" then
            pcall(function() environment.toclipboard = toclipboard end)
        end
        for _, fnName in ipairs({
            "makefolder", "isfolder", "writefile", "appendfile", "readfile",
            "listfiles", "isfile", "delfile", "delfolder", "getcustomasset",
            "getsynasset", "loadfile", "renamefile", "movefile", "copyfile",
        }) do
            if type(originalFs[fnName]) == "function" then
                -- getfenv(0) est l'environnement de ce script Lua.
                -- Evite de supposer que _G et getgenv() sont identiques.
                local okFn, wrapped = pcall(function()
                    local env = type(getfenv) == "function" and getfenv(0) or _G
                    return env and env[fnName]
                end)
                if okFn and type(wrapped) == "function" then
                    pcall(function() environment[fnName] = wrapped end)
                end
            end
        end
        pcall(function() environment.WindUIFrontendConfig = UI end)
    end
end

