-- Remplace aussi les liens inclus dans des descriptions / textes enrichis.
local function replaceDiscordInvite(value)
    if type(value) ~= "string" then return value end
    local target = UI.Home.DiscordInvite
    value = value:gsub("[Dd][Ii][Ss][Cc][Oo][Rr][Dd]%.gg/[%w_%-]+", target)
    value = value:gsub("[Dd][Ii][Ss][Cc][Oo][Rr][Dd]%.com/invite/[%w_%-]+", target)
