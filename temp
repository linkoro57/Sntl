-- N'ote que les elements de Home peuvent venir d'un contenu chiffre.
-- Nous filtrons donc leur configuration au moment ou WindUI les construit.
local function isRankStat(title)
    if type(title) ~= "string" then return false end
    local text = title:lower():gsub("<[^>]+>", ""):gsub("[%*`_]", "")
    text = text:match("^%s*(.-)%s*$") or text
    return text == "rank" or text:match("^rank%s*[:%-]") ~= nil
end

local function removeRankText(value)
    if type(value) ~= "string" or not UI.Home.RemoveRank then return value end
    -- Pour une ligne de statistique, retirer toute la ligne Rank.
    local pieces = {}
    local hadNewline = value:find("\n", 1, true) ~= nil
    for line in (value .. "\n"):gmatch("(.-)\n") do
        if not isRankStat(line) then pieces[#pieces + 1] = line end
    end
    value = table.concat(pieces, "\n")
    -- Pour des stats separees par des barres sur une meme ligne.
    value = value:gsub("%s*|%s*[Rr][Aa][Nn][Kk]%s*:%s*[^|\r\n]+", "")
    value = value:gsub("^[Rr][Aa][Nn][Kk]%s*:%s*[^|\r\n]+%s*|%s*", "")
    if hadNewline then return value end
    return value
end

