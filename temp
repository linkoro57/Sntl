local function patchHomeConfig(config, discordParent, depth)
    if type(config) ~= "table" or depth > 8 then return config end
    local copy = cloneTable(config)
    local isDiscord = discordParent
        or isDiscordTitle(copy.Title) or isDiscordTitle(copy.Name)
        or isDiscordTitle(copy.Desc) or isDiscordTitle(copy.Description)
    for key, value in pairs(copy) do
        if UI.Home.HideImages and homeImageKeys[key] then
            copy[key] = nil
        elseif UI.Home.RemoveRank and type(key) == "string"
            and key:lower() == "rank" then
            copy[key] = nil
        elseif type(value) == "string" then
            value = sentinelText(replaceDiscordInvite(value))
            if homeTextKeys[key] then value = removeRankText(value) end
            copy[key] = value
        elseif type(value) == "table" then
            if UI.Home.RemoveRank and (key == "Stats" or key == "Statistics") then
                local kept = {}
                for i, item in ipairs(value) do
                    if type(item) ~= "table"
                        or not isRankStat(item.Title or item.Name or item.Label) then
                        kept[#kept + 1] = patchHomeConfig(item, isDiscord, depth + 1)
                    end
                end
                if #value > 0 then
                    copy[key] = kept
                else
                    copy[key] = patchHomeConfig(value, isDiscord, depth + 1)
                end
            else
                copy[key] = patchHomeConfig(value, isDiscord, depth + 1)
            end
        end
    end
    -- Dans le panneau Discord, les boutons utilisent le nouveau lien,
    -- meme si leur ancien callback contenait une URL obfusquee.
    if isDiscord and type(copy.Callback) == "function" then
        copy.Callback = copyDiscordInvite
    end
    return copy
end

cloneTable = function(source)
    if type(source) ~= "table" then return source end
    local result = {}
    for key, value in pairs(source) do result[key] = value end
    return result
end

-- =============================================
-- DISCORD SNTL : COMPTEURS REELS (APPROXIMATIFS)
-- =============================================
-- Discord expose ces valeurs via GET /invites/sntl?with_counts=true.
-- Ne jamais inventer des chiffres : en l'absence de reponse valide, afficher "...".
local discordCounts = { members = nil, online = nil }
local trackedDiscordStats = {}
local discordSyncToken = {}

local function countLabelKind(value)
    if type(value) ~= "string" then return nil end
    local label = value:lower():gsub("<[^>]+>", "")
    if label:find("online", 1, true) or label:find("active", 1, true)
        or label:find("en ligne", 1, true) then
        return "online"
    end
    if label:find("member", 1, true) or label:find("membre", 1, true) then
        return "members"
    end
    return nil
end

local function statNumber(kind)
    local number = discordCounts[kind]
    return type(number) == "number" and tostring(number) or "..."
end

local statValueKeys = {
    Desc = true, Description = true, Text = true, Content = true,
    Value = true, Subtitle = true, SubTitle = true,
}
local statDisplayKeys = {
    Title = true, Name = true, Label = true, Desc = true,
    Description = true, Text = true, Content = true,
    Value = true, Subtitle = true, SubTitle = true,
}

-- Synchronise les compteurs dans les textes comme
-- "Members: 123 | Online: 12", "Member Count: 123" ou "12 members".
local function replaceInlineStatValues(value)
    if type(value) ~= "string" then return value, false end
    local changed = false
    local function substitute(pattern, kind)
        value = value:gsub(pattern, function(before, after)
            changed = true
            return before .. statNumber(kind)
        end)
    end
    -- Valeurs apres un intitule ; la ponctuation et les espaces sont conserves.
    substitute("([Mm][Ee][Mm][Bb][Ee][Rr][Ss]?%s*[Cc][Oo][Uu][Nn][Tt]%s*[:%-]%s*)([%d%.,]+)", "members")
    substitute("([Mm][Ee][Mm][Bb][Ee][Rr][Ss]?%s*[:%-]%s*)([%d%.,]+)", "members")
    substitute("([Oo][Nn][Ll][Ii][Nn][Ee]%s*[Cc][Oo][Uu][Nn][Tt]%s*[:%-]%s*)([%d%.,]+)", "online")
    substitute("([Oo][Nn][Ll][Ii][Nn][Ee]%s*[:%-]%s*)([%d%.,]+)", "online")
    -- Valeurs avant l'intitule, par ex. "123 Members".
    value = value:gsub("([%d%.,]+)(%s+[Mm][Ee][Mm][Bb][Ee][Rr][Ss]?)", function(number, label)
        changed = true
        return statNumber("members") .. label
    end)
    value = value:gsub("([%d%.,]+)(%s+[Oo][Nn][Ll][Ii][Nn][Ee])", function(number, label)
        changed = true
        return statNumber("online") .. label
    end)
    return value, changed
end

local function renderDiscordStatValue(value, kind, field)
    if not statDisplayKeys[field] then return value, false end
    local rendered, changed = replaceInlineStatValues(value)
    if changed then return rendered, true end
    -- Pour des composants du type {Title="Member Count", Desc="123"},
    -- seul le champ contenant le chiffre devient dynamique.
    if kind and statValueKeys[field] and (type(value) == "number" or type(value) == "string") then
        local text = tostring(value)
        if text:match("^%s*[%d%.,%s]+%s*$") or text:match("^%s*[%-%–%.]+%s*$")
            or text:lower():match("^%s*loading[%.%s]*$")
            or text:lower():match("^%s*fetching[%.%s]*$")
            or text:lower():match("^%s*n/?a%s*$") then
            return statNumber(kind), true
        end
    end
    return value, false
end

-- Renvoie la configuration avec les vraies valeurs et les modeles a re-appliquer.
local function prepareDiscordStatConfig(config)
    if type(config) ~= "table" then return config, nil end
    local result, templates = cloneTable(config), {}
    local kind = countLabelKind(config.Title) or countLabelKind(config.Name)
        or countLabelKind(config.Label)
    for field, value in pairs(config) do
        if statDisplayKeys[field] then
            local rendered, dynamic = renderDiscordStatValue(value, kind, field)
            if dynamic then
                result[field] = rendered
                templates[field] = { original = value, kind = kind }
            end
        end
    end
    if next(templates) then return result, templates end
    return result, nil
end

local statSetterByField = {
    Title = {"SetTitle"}, Name = {"SetTitle"}, Label = {"SetTitle", "SetText"},
    Desc = {"SetDesc", "SetDescription"}, Description = {"SetDesc", "SetDescription"},
    Text = {"SetText", "SetDesc"}, Content = {"SetDesc", "SetText"},
    Value = {"SetValue", "SetText", "SetDesc"},
    Subtitle = {"SetDesc", "SetText"}, SubTitle = {"SetDesc", "SetText"},
}
local function applyDiscordStatToElement(element, templates)
    for field, model in pairs(templates) do
        local newValue = renderDiscordStatValue(model.original, model.kind, field)
        for _, setter in ipairs(statSetterByField[field] or {}) do
            local ok, candidate = pcall(function() return element[setter] end)
            if ok and type(candidate) == "function" then
                local applied = pcall(candidate, element, newValue)
                if applied then break end
            end
        end
    end
end
local function refreshTrackedDiscordStats()
    for _, record in ipairs(trackedDiscordStats) do
        applyDiscordStatToElement(record.element, record.templates)
    end
end

-- Selon l'executeur Roblox, HttpService:GetAsync n'est pas toujours autorise.
-- Les fonctions de requete de l'executeur sont essayees avant les autres.
local function getDiscordResponse(url)
    local nativeRequest = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
        or (type(http) == "table" and type(http.request) == "function" and http.request)
    if type(nativeRequest) == "function" then
        local ok, response = pcall(nativeRequest, {
            Url = url, Method = "GET", Headers = { Accept = "application/json" },
        })
        if ok and type(response) == "table" then
            local status = tonumber(response.StatusCode or response.Status)
            if status and status >= 200 and status < 300 and type(response.Body) == "string" then
                return response.Body
            end
        end
    end
    if game then
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if ok and type(result) == "string" then return result end
        local okSvc, service = pcall(function() return game:GetService("HttpService") end)
        if okSvc and service then
            local okAsync, body = pcall(function() return service:GetAsync(url) end)
            if okAsync and type(body) == "string" then return body end
        end
    end
    return nil
end

local function fetchDiscordCounts()
    local url = "https://discord.com/api/v10/invites/"
        .. UI.Home.DiscordInviteCode .. "?with_counts=true"
    local body = getDiscordResponse(url)
    if type(body) ~= "string" then return false end
    local okSvc, service = pcall(function() return game:GetService("HttpService") end)
    if not okSvc or not service then return false end
    local ok, data = pcall(function() return service:JSONDecode(body) end)
    if not ok or type(data) ~= "table" then return false end
    local members = tonumber(data.approximate_member_count)
    local online = tonumber(data.approximate_presence_count)
    if not members or not online or members < 0 or online < 0 then return false end
    discordCounts.members = math.floor(members)
    discordCounts.online = math.floor(online)
    refreshTrackedDiscordStats()
    return true
end

local function startDiscordCountSync()
    if type(task) ~= "table" or type(task.spawn) ~= "function"
        or type(task.wait) ~= "function" then return end
    local generation = discordSyncToken
    if type(getgenv) == "function" then
        pcall(function() getgenv().SentinelDiscordSyncToken = generation end)
    end
    task.spawn(function()
        while true do
            -- Empêche plusieurs boucles après une ré-exécution du script.
            if type(getgenv) == "function" then
                local ok, env = pcall(getgenv)
                if ok and type(env) == "table"
                    and env.SentinelDiscordSyncToken ~= generation then break end
            end
            pcall(fetchDiscordCounts)
