-- Un seul bloc "Beta" ; les noms sont groupes par onglet dans sa description.
-- Le contenu se met a jour au fur et a mesure que le frontend se construit.
local function updateFeatureChangelog()
    if not changelogContainer then return end
    local create = nativeParagraphs[changelogContainer]
    if type(create) ~= "function" then return end
    local lines = {}
    for _, tab in ipairs(featureGroupOrder) do
        local group = featureGroups[tab]
        if group and #group.titles > 0 then
            lines[#lines + 1] = tab .. ":"
            for _, title in ipairs(group.titles) do
                lines[#lines + 1] = title
            end
            lines[#lines + 1] = ""
        end
    end
    local description = table.concat(lines, "\n")
    if not changelogBeta then
        local ok, element = pcall(create, changelogContainer, {
            Title = "Beta", Desc = description,
        })
        if ok then changelogBeta = element end
    else
        local ok, setter = pcall(function() return changelogBeta.SetDesc end)
        if ok and type(setter) == "function" then
            pcall(setter, changelogBeta, description)
        else
            -- Certaines variantes de WindUI exposent Set(config).
            local okSet, set = pcall(function() return changelogBeta.Set end)
            if okSet and type(set) == "function" then
                pcall(set, changelogBeta, {Title = "Beta", Desc = description})
            end
        end
    end
end

local function addFeature(tab, title)
    title = sentinelText(title)
    if type(title) ~= "string" or title:match("^%s*$") then return end
    tab = sentinelText(tab or "Features")
    if isChangelogTitle(tab) or tab:lower():match("^%s*home%s*$") then return end
    if not featureGroups[tab] then
        featureGroups[tab] = {titles = {}, seen = {}}
        featureGroupOrder[#featureGroupOrder + 1] = tab
    end
    local group = featureGroups[tab]
    if not group.seen[title] then
        group.seen[title] = true
        group.titles[#group.titles + 1] = "• " .. title
        updateFeatureChangelog()
    end
end

-- La version precedente consommait l'unique suppression des qu'une
-- notification (Notify) apparaissait. Le vrai Dialog suivant etait alors
-- encore appele, parfois avant l'initialisation de Window.UICorner dans
-- WindUI. On supprime donc uniquement les modales (Dialog/Popup) du lobby
-- pendant l'amorcage, jamais les notifications classiques.
local startupClock = type(os) == "table" and type(os.clock) == "function"
    and os.clock() or nil
local function suppressLobbyStartupPopup()
    if not UI.Branding.RemoveStartupPopupInLobby then return false end
    local ok, placeId = pcall(function() return game.PlaceId end)
    if not ok or tonumber(placeId) ~= UI.Branding.LobbyPlaceId then
        return false
    end
    if startupClock and type(os.clock) == "function" and
        os.clock() - startupClock > UI.Branding.PopupStartupSeconds then
        return false
    end
    return true
end

-- IMPORTANT : "Workspace" dans la demande est le stockage LOCAL de Madium
-- (par ex. C:\Users\...\Madium\Workspace), PAS game.Workspace.
-- Le code precedent creait de vrais Folder dans Roblox ; ce comportement est
-- supprime. On redirige les fonctions de fichiers de l'executeur a la place.
local function redirectFsPath(path)
    if type(path) ~= "string" then return path end
    -- Identifier uniquement un segment complet H4xScripts, pas un fichier dont
    -- le nom contient ce texte. Accepte les deux separateurs Windows et Lua.
    local legacy = "[Hh]4[Xx][Ss][Cc][Rr][Ii][Pp][Tt][Ss]"
    local target = UI.Branding.WorkspaceRoot
    path = path:gsub("^" .. legacy .. "([/\\])", target .. "%1")
    path = path:gsub("([/\\])" .. legacy .. "([/\\])", "%1" .. target .. "%2")
    path = path:gsub("([/\\])" .. legacy .. "$", "%1" .. target)
    path = path:gsub("^" .. legacy .. "$", target)
    return path
end

local function wrapFsOne(native)
    if type(native) ~= "function" then return native end
    return function(path, ...)
        return native(redirectFsPath(path), ...)
    end
end
local function wrapFsTwo(native)
    if type(native) ~= "function" then return native end
    return function(src, dst, ...)
        return native(redirectFsPath(src), redirectFsPath(dst), ...)
    end
end

